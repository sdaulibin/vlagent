pipeline {

    agent {
        node {
            label "star"
            customWorkspace "/home/jenkins/workspace/${env.JOB_NAME}_${env.BUILD_NUMBER}"
        }
    }

    options{
        skipDefaultCheckout true
        disableConcurrentBuilds()
    }

    // 构建参数
    parameters {
        string(name: 'projectName', defaultValue: 'opagent', description: 'project name')
        string(name: 'tag', defaultValue: '', description: 'image tag')
        string(name: 'ftpCredential', defaultValue: 'xyk-prd-ftp-credential', description: 'ftp credential')
        string(name: 'ftpPath', defaultValue: '', description: 'a ftp relative path')
        string(name: 'ftpAddr', defaultValue: '10.1.89.31', description: 'ftp ip address')
        string(name: 'HARBOR_URL', defaultValue: 'harbor.qdccb.cn', description: 'harbor url')
        string(name: 'HARBOR_PROJECT', defaultValue: 'one-paper', description: 'harbor project name')
        choice(choices: ['false', 'true'], description: '是否指定机器部署', name: 'SPECIFY_NODE')
        string(name: 'DESTINATION_KEY', defaultValue: "qdccb\\.cn/role", description: '要部署的目标机器')
        string(name: 'DESTINATION_VALUE', defaultValue: 'one-paper', description: '要部署的目标机器')
        string(name: 'HELM_NS', defaultValue: 'one-paper', description: 'k8s namespace')
        string(name: 'ingress', defaultValue: 'nginx-one-paper-prd', description: 'ingress class name')
        string(name: 'replicas', defaultValue: '2', description: 'replica count')
        string(name: 'ingressHost', defaultValue: 'opagent.qdccb.cn', description: 'ingress host')

        // 容忍度配置
        string(name: 'TOLERATION_KEY', defaultValue: 'env', description: '容忍度key')
        string(name: 'TOLERATION_VALUE', defaultValue: 'prd', description: '容忍度value')
        string(name: 'TOLERATION_EFFECT', defaultValue: 'NoSchedule', description: '容忍度效果')
        string(name: 'TOLERATION_OPERATOR', defaultValue: 'Equal', description: '容忍度操作符')

        // =====================================================================
        // 应用基础配置
        // =====================================================================
        string(name: 'APP_ENV', defaultValue: 'uat', description: 'Application environment')
        string(name: 'QWEN35_URL', defaultValue: 'http://10.1.84.77/v1', description: 'Qwen3.5 API URL')
        string(name: 'QWEN35_MODEL', defaultValue: 'llm_xindai_01', description: 'Qwen3.5 模型名称')
        string(name: 'QWEN35_KEY', defaultValue: '72cf9079-f206-40f0-bd33-3957099a571c', description: 'Qwen3.5 API Key')
        string(name: 'RECOGNITION_TIMEOUT', defaultValue: '1800', description: '识别超时时间(秒)')
        string(name: 'JWT_ALGORITHM', defaultValue: 'HS256', description: 'JWT 算法')
        string(name: 'JWT_SECRET', defaultValue: 'ioa', description: 'JWT 密钥')
        string(name: 'DATABASE_URL', defaultValue: 'postgresql+asyncpg://ioa:ioa123456@pg-ha.postgresql-ha:5432/vlagent', description: '数据库 URL')
        string(name: 'DATABASE_UPSTREAM_URL', defaultValue: 'postgresql+asyncpg://postgres:ioauat123456@10.238.146.99:31432/ioa', description: '上游数据库 URL')
        string(name: 'SYNC_INTERVAL_MINUTES', defaultValue: '120', description: '同步间隔时间(分钟)')
        string(name: 'PERMISSION_DEFAULT_OPEN', defaultValue: 'false', description: '无权限记录时是否默认开放所有模块(SIT环境默认开放)')
        string(name: 'API_PREFIX', defaultValue: '/vlagent/api', description: 'API 路由前缀')
        string(name: 'CORS_ORIGINS', defaultValue: 'https://ai.qdccb.cn:9900', description: 'CORS 允许的源(逗号分隔)')
        string(name: 'ARCH', defaultValue: 'amd64', description: '架构')
    }
    stages {

        stage('Helm Deploy Application') {
            steps {
                script {
                    echo "get imagefile from ftp……"
                    withCredentials([usernamePassword(credentialsId: env.ftpCredential, usernameVariable: 'SFTP_USER', passwordVariable: 'SFTP_PASSWORD')]) {
                        def imageDownloadCommand = """
                            sshpass -p '${SFTP_PASSWORD}' sftp -o StrictHostKeyChecking=no ${SFTP_USER}@${env.ftpAddr} << EOF
                            cd ${env.ftpPath}
                            get ${env.projectName}-${env.tag}.tar
                            bye
                            EOF
                        """
                        def imageDownloadStatus = sh(script: imageDownloadCommand, returnStatus: true)

                        if (imageDownloadStatus != 0) {
                            error "Failed to download image file from SFTP server"
                        }
                        echo "get imagefile from ftp…… done"

                        echo "get chart file from ftp……"
                        def chartDownloadCommand = """
                            sshpass -p '${SFTP_PASSWORD}' sftp -o StrictHostKeyChecking=no ${SFTP_USER}@${env.ftpAddr} << EOF
                            cd ${env.ftpPath}
                            get ${env.projectName}-${env.tag}-chart.tar.gz
                            bye
                            EOF
                        """
                        def chartDownloadStatus = sh(script: chartDownloadCommand, returnStatus: true)

                        if (chartDownloadStatus != 0) {
                            error "Failed to download chart file from SFTP server"
                        }
                        echo "get chart file from ftp…… done"
                    }

                    sh """
                        export DOCKER_CONFIG="/kaniko/.docker/"
                        nerdctl load -i ${env.projectName}-${env.tag}.tar
                        nerdctl --insecure-registry=true push \\
                            ${env.HARBOR_URL}/${env.HARBOR_PROJECT}/${env.projectName}:${tag}-${env.ARCH}

                        tar -zxf ${env.projectName}-${env.tag}-chart.tar.gz -C .
                    """

                    def node_selected = env.SPECIFY_NODE
                    def helmSetBase = """
                        deploy/charts --namespace ${env.HELM_NS} --create-namespace \
                        -f deploy/charts/values.yaml \
                        --set image.repository=${env.HARBOR_URL}/${env.HARBOR_PROJECT}/${env.projectName} \
                        --set image.tag=${env.RELEASE_VERSION}-amd64 \
                        --set server.ingress.className=${env.ingress} \
                        --set server.ingress.hosts[0].host=${env.ingressHost} \
                        --set server.replicaCount=${env.serverReplicas} \
                        --set envConfig.APP_ENV="${env.APP_ENV}" \
                        --set envConfig.QWEN35_URL="${env.QWEN35_URL}" \
                        --set envConfig.QWEN35_MODEL="${env.QWEN35_MODEL}" \
                        --set envConfig.RECOGNITION_TIMEOUT="${env.RECOGNITION_TIMEOUT}" \
                        --set envConfig.JWT_ALGORITHM="${env.JWT_ALGORITHM}" \
                        --set envConfig.PERMISSION_DEFAULT_OPEN="${env.PERMISSION_DEFAULT_OPEN}" \
                        --set envConfig.API_PREFIX="${env.API_PREFIX}" \
                        --set envConfig.CORS_ORIGINS="${env.CORS_ORIGINS}" \
                        --set server.tolerations[0].key="${env.TOLERATION_KEY}" \
                        --set server.tolerations[0].operator="${env.TOLERATION_OPERATOR}" \
                        --set server.tolerations[0].value="${env.TOLERATION_VALUE}" \
                        --set server.tolerations[0].effect="${env.TOLERATION_EFFECT}" \
                        --set secret.enabled=true \
                        --set secret.DATABASE_URL="${env.DATABASE_URL}" \
                        --set secret.DATABASE_UPSTREAM_URL="${env.DATABASE_UPSTREAM_URL}" \
                        --set secret.SYNC_INTERVAL_MINUTES="${env.SYNC_INTERVAL_MINUTES}" \
                        --set secret.QWEN35_KEY="${env.QWEN35_KEY}" \
                        --set secret.JWT_SECRET="${env.JWT_SECRET}" \
                        --set secret.ECM_PASSWORD="${env.ECM_PASSWORD}" \
                    """.stripIndent().trim()

                    if(node_selected == 'true') {
                        sh """
                           export DOCKER_CONFIG="/kaniko/.docker/"
                           helm upgrade --install ${env.projectName} \
                           -f deploy/charts/values.yaml \
                           --set "server.nodeSelector.${env.DESTINATION_KEY}=${env.DESTINATION_VALUE}" \
                           --set "worker.nodeSelector.${env.DESTINATION_KEY}=${env.DESTINATION_VALUE}" \
                           ${helmSetBase}
                        """
                    } else {
                        sh """
                           helm upgrade --install ${env.projectName} \
                           ${helmSetBase}
                        """
                    }
                    sh """
                        helm get manifest --namespace ${env.HELM_NS} ${env.projectName}
                    """
                }
            }
        }

    }

    post {
        always {
            script {
                cleanWs()
            }
        }
    }

}